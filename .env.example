# Backend
APP_ENV=development
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
ENGINE_VERSION=dev

# Local PostgreSQL example only.
# Never commit a real database URL.
DATABASE_URL=postgres://timetrap:change-me@localhost:5432/timetrap_dev?sslmode=disable
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_GITHUB_URL=https://github.com/kernelKain/timetrap
